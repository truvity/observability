      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{k8s_cluster_name=~\"$cluster\",job=\"cnpg-system/cnpg-cloudnative-pg\",namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{controller}}",
          "range": true,
          "instant": false,
          "refId": "A"
