      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(vm_rows_inserted_total{k8s_cluster_name=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "metrics {{job}}",
          "range": true,
          "instant": false,
          "refId": "A"
