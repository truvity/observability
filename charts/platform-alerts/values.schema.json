{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform-alerts",
  "description": "Alerting rules that catch a backup, a store or a volume failing silently. Strict: an unknown key fails the render rather than being silently ignored, because a typo in an alerting chart is a rule that never fires.",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "definitions": {
    "upstreamGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Rule names (alert or record) left out of the group."
        },
        "override": {
          "type": "object",
          "description": "Rule name to the fields merged over the vendored rule.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expr": { "type": "string", "minLength": 1 },
              "for": { "type": "string" },
              "keep_firing_for": { "type": "string" },
              "labels": { "type": "object", "additionalProperties": { "type": "string" } },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$",
      "description": "A MetricsQL duration, e.g. 30s, 5m, 26h."
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "warning", "info"],
      "description": "The severity label the Alertmanager routing tree reads."
    },
    "ruleSwitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "for": { "$ref": "#/definitions/duration" },
        "severity": { "$ref": "#/definitions/severity" }
      }
    },
    "windowedRuleSwitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "window": { "$ref": "#/definitions/duration" },
        "for": { "$ref": "#/definitions/duration" },
        "severity": { "$ref": "#/definitions/severity" }
      }
    },
    "windowedRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": { "$ref": "#/definitions/duration" },
        "for": { "$ref": "#/definitions/duration" }
      }
    },
    "labelMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "ruleLabels": { "$ref": "#/definitions/labelMap" },
    "commonLabels": { "$ref": "#/definitions/labelMap" },
    "runbookBaseUrl": { "type": "string" },
    "interval": { "$ref": "#/definitions/duration" },
    "absentLookback": { "$ref": "#/definitions/duration" },
    "clusterLabel": {
      "type": "string",
      "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$",
      "description": "The label naming the cluster on a shared metrics store; matched in every join. Empty disables it."
    },
    "ownerLabel": {
      "type": "string",
      "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$",
      "description": "OPT-IN. The label naming the owning company (observability-emitters tenancy.owners stamps `owner`); added to the by (...) of the aggregating rules so the alert keeps it. Empty changes nothing."
    },
    "namespaceSelector": {
      "type": "string",
      "minLength": 1,
      "description": "A regular expression. Objects in namespaces that do not match are ignored."
    },
    "stores": {
      "type": "array",
      "description": "One entry per store process. No default: a guessed metric name is how a rule silently never fires.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Labels the alert; not a Kubernetes object name."
          },
          "rowsMetric": {
            "type": "string",
            "minLength": 1,
            "description": "The counter the write-path deadman watches."
          },
          "freeSpaceMetric": {
            "type": "string",
            "minLength": 1,
            "description": "The store's own exported free-space gauge."
          },
          "freeSpaceLimitMetric": {
            "type": "string",
            "minLength": 1,
            "description": "The store's own exported limit at which it stops accepting writes."
          }
        },
        "dependencies": {
          "freeSpaceMetric": ["freeSpaceLimitMetric"],
          "freeSpaceLimitMetric": ["freeSpaceMetric"]
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backups", "writePath", "volumes", "storeLimits", "kargo", "pendingPods", "nodeClaims", "nodeMemoryPressure", "probes", "nats", "argocd", "eso", "ack", "podSecurity", "podSecurityAudit", "envoyRoutes", "certificates", "restarts", "workloadAbsent", "pulumiDrift", "upstream"],
      "properties": {
        "backups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSuccessAge": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "failedSeverity": { "$ref": "#/definitions/severity" },
            "ignoreSuspended": {
              "type": "boolean",
              "description": "Default true: both backup rules skip a CronJob whose kube_cronjob_spec_suspend is 1. `false` renders the 0.10.0 expressions."
            },
            "namespaceSelector": { "type": "string" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "writePath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" }
          }
        },
        "volumes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minCapacityRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "A ratio, so never above 1: a mounted filesystem is always somewhat smaller than its claim."
            },
            "severity": { "$ref": "#/definitions/severity" }
          }
        },
        "storeLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "headroomFactor": {
              "type": "number",
              "exclusiveMinimum": 1,
              "description": "Above 1, or the alert arrives at the moment writes already fail."
            },
            "severity": { "$ref": "#/definitions/severity" }
          }
        },
        "kargo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "absentFor": { "$ref": "#/definitions/duration" },
            "absentSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" },
            "controllerJob": { "type": "string", "minLength": 1 },
            "controllerAbsent": { "$ref": "#/definitions/ruleSwitch" },
            "reconcileErrors": { "$ref": "#/definitions/windowedRuleSwitch" },
            "workqueueDepth": { "$ref": "#/definitions/ruleSwitch" }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "alertName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "probe": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "pattern": "^[^{}]*$", "description": "Plain text replacing the alert's summary. No template braces. Empty keeps the generated summary." },
            "description": { "type": "string", "pattern": "^[^{}]*$", "description": "Plain text replacing the alert's description. No template braces. Empty keeps the generated description." },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "absentFor": { "$ref": "#/definitions/duration" },
            "absentSeverity": { "type": "string", "enum": ["", "critical", "warning", "info"], "description": "Severity of the deadman. Empty takes `severity`." },
            "certExpiry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "alertName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
                "withinDays": { "type": "integer", "minimum": 1 },
                "for": { "$ref": "#/definitions/duration" },
                "severity": { "$ref": "#/definitions/severity" }
              }
            }
          }
        },
        "pendingPods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "namespaceSelector": { "type": "string" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "nodeClaims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "absentFor": { "$ref": "#/definitions/duration" },
            "absentSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "nodeMemoryPressure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "criticalThreshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 renders no critical alert." },
            "criticalFor": { "$ref": "#/definitions/duration" },
            "criticalSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "job": { "type": "string", "minLength": 1 },
            "severity": { "$ref": "#/definitions/severity" },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "brokerDownFor": { "$ref": "#/definitions/duration" },
            "routesFor": { "$ref": "#/definitions/duration" },
            "leaderFor": { "$ref": "#/definitions/duration" },
            "backlog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "window": { "$ref": "#/definitions/duration" },
                "minPending": { "type": "integer", "minimum": 0 },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "slowConsumers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "window": { "$ref": "#/definitions/duration" },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "memory": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespace": { "type": "string", "minLength": 1 },
                "container": { "type": "string", "minLength": 1 },
                "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "absentFor": { "$ref": "#/definitions/duration" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "job": { "type": "string", "minLength": 1 },
            "severity": { "$ref": "#/definitions/severity" },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "syncFailed": { "$ref": "#/definitions/windowedRule" },
            "unhealthyFor": { "$ref": "#/definitions/duration" },
            "outOfSync": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "clusterLostFor": { "$ref": "#/definitions/duration" },
            "gitFetch": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "window": { "$ref": "#/definitions/duration" },
                "minFailures": { "type": "integer", "minimum": 1 },
                "for": { "$ref": "#/definitions/duration" }
              }
            },
            "absentFor": { "$ref": "#/definitions/duration" },
            "absentSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "eso": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "webhookJob": { "type": "string", "minLength": 1 },
            "severity": { "$ref": "#/definitions/severity" },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "webhookDownFor": { "$ref": "#/definitions/duration" },
            "notReadyFor": { "$ref": "#/definitions/duration" },
            "storeNotReadyFor": { "$ref": "#/definitions/duration" },
            "reconcileErrors": { "$ref": "#/definitions/windowedRule" },
            "providerErrors": { "$ref": "#/definitions/windowedRule" },
            "workqueueFor": { "$ref": "#/definitions/duration" },
            "absentFor": { "$ref": "#/definitions/duration" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "envoyRoutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "job": { "type": "string" },
            "routeSelector": { "type": "string" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "warningRatio": { "type": "number", "minimum": 0 },
            "criticalRatio": { "type": "number", "minimum": 0 },
            "warningLatencyMs": { "type": "number", "minimum": 0 },
            "criticalLatencyMs": { "type": "number", "minimum": 0 },
            "minRequestsPerSecond": { "type": "number", "minimum": 0 },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "criticalSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "certificates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "string" },
            "warningDays": { "type": "number", "minimum": 0 },
            "criticalDays": { "type": "number", "minimum": 0 },
            "notReadyFor": { "$ref": "#/definitions/duration" },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "criticalSeverity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "restarts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "string" },
            "window": { "$ref": "#/definitions/duration" },
            "oomSeverity": { "$ref": "#/definitions/severity" },
            "restartWindow": { "$ref": "#/definitions/duration" },
            "maxRestarts": { "type": "number", "minimum": 0 },
            "restartSeverity": { "$ref": "#/definitions/severity" },
            "slowRestartWindow": { "$ref": "#/definitions/duration" },
            "slowMaxRestarts": { "type": "number", "minimum": 0 },
            "slowRestartFor": { "$ref": "#/definitions/duration" },
            "slowRestartSeverity": { "$ref": "#/definitions/severity" },
            "slowRestartExcludeNamespaces": { "type": "string" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "workloadAbsent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "type": "string" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "description": "The vendored upstream rule pack (restructure step 4); see upstream/PIN.yaml.",
          "properties": {
            "enabled": { "type": "boolean", "description": "Render the vendored upstream rule groups. Default false." },
            "alertmanagerNamespace": { "type": "string", "description": "Namespace of the Alertmanager the vendored alertmanager.rules group is scoped to; empty is the release namespace." },
            "alertmanager.rules": { "$ref": "#/definitions/upstreamGroup" },
            "general.rules": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_cpu_limits": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_cpu_requests": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_cpu_usage_seconds_total": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_cache": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_limits": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_requests": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_rss": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_swap": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.container_memory_working_set_bytes": { "$ref": "#/definitions/upstreamGroup" },
            "k8s.rules.pod_owner": { "$ref": "#/definitions/upstreamGroup" },
            "kube-apiserver-availability.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kube-apiserver-burnrate.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kube-apiserver-histogram.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kube-apiserver-slos": { "$ref": "#/definitions/upstreamGroup" },
            "kube-prometheus-general.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kube-prometheus-node-recording.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kube-scheduler.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kubelet.rules": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-apps": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-resources": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-storage": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-system": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-system-apiserver": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-system-controller-manager": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-system-kubelet": { "$ref": "#/definitions/upstreamGroup" },
            "kubernetes-system-scheduler": { "$ref": "#/definitions/upstreamGroup" },
            "node-network": { "$ref": "#/definitions/upstreamGroup" },
            "node.rules": { "$ref": "#/definitions/upstreamGroup" },
            "vm-health": { "$ref": "#/definitions/upstreamGroup" },
            "vmalert": { "$ref": "#/definitions/upstreamGroup" },
            "vmoperator": { "$ref": "#/definitions/upstreamGroup" },
            "vmsingle": { "$ref": "#/definitions/upstreamGroup" }
          }
        },
        "pulumiDrift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "lookback": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "errorSeverity": { "$ref": "#/definitions/severity" },
            "staleAfter": { "$ref": "#/definitions/duration" },
            "staleLookback": { "$ref": "#/definitions/duration" },
            "staleSeverity": { "$ref": "#/definitions/severity" },
            "runbookUrl": { "type": "string" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "podSecurity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "podSecurityAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/severity" },
            "keepClusterLabel": { "type": "boolean" }
          }
        },
        "ack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "minLength": 1 },
            "expectedNamespaces": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "uniqueItems": true
            },
            "severity": { "$ref": "#/definitions/severity" },
            "warningSeverity": { "$ref": "#/definitions/severity" },
            "downFor": { "$ref": "#/definitions/duration" },
            "absentFor": { "$ref": "#/definitions/duration" },
            "reconcileErrors": { "$ref": "#/definitions/windowedRule" },
            "terminalErrors": { "$ref": "#/definitions/windowedRule" },
            "panics": { "$ref": "#/definitions/windowedRule" },
            "keepClusterLabel": { "type": "boolean" }
          }
        }
      }
    }
  }
}
