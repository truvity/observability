    {
      "id": 7,
      "type": "timeseries",
      "title": "Reconciles per second, by controller",
      "description": "Reconcile rate per operator control loop (cluster, backup, pooler, scheduled backup), split by result. A loop that stops reconciling while clusters exist is a stuck operator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (controller, result) (rate(controller_runtime_reconcile_total{k8s_cluster_name=~\"$cluster\",job=\"cnpg-system/cnpg-cloudnative-pg\",namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{controller}} {{result}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
