{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "observability-stack",
  "description": "One install of a self-hosted observability stack. Strict where this chart defines the structure: an unknown key fails the render rather than being silently ignored, because a typo in a retention, a filter or a secret name is an install that comes up and is wrong. The upstream charts' own sections stay open \u2014 their surface is theirs, and closing it would refuse every legitimate key the vendor adds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interval",
    "storeCredentials",
    "vmauth",
    "tenancy"
  ],
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$",
      "description": "A duration with a unit, e.g. 30s, 5m, 1h."
    },
    "retention": {
      "type": "string",
      "pattern": "^[0-9]+(h|d|w|M|y)$",
      "description": "A retention period WITH A UNIT. A bare number is read as months by every store in this family, so the unit is required here rather than left to a default nobody expects. The month unit is a capital M."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "A plain name. This is a security boundary rather than a style rule: cluster and namespace names are interpolated into a filter expression, so one carrying | or .* would widen the grant it appears in."
    },
    "labelName": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "description": "A Prometheus label name: the key a metrics filter selects on, so it has to be one a series can carry - no dots, no dashes, no slashes."
    },
    "logFieldName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_./-]*$",
      "description": "A LOG FIELD NAME, which is a different question from a plain name and has a different answer. A log agent names its own fields, and a real one carries dots: kubernetes.pod_namespace, k8s.cluster.name. The shape admits those and refuses everything that is stream-filter syntax - a quote, a brace, a comma, an equals sign, a pipe, a colon, whitespace - because the name is interpolated into the filter and one of those would widen the grant rather than look odd."
    },
    "audience": {
      "type": "string",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9_:@-]*)?$",
      "description": "An OAuth client id: the audience this proxy's tokens are minted for. vmauth compiles every matchClaims value as a REGULAR EXPRESSION, so the shape admits what an opaque identifier is built from - letters, digits, -, _, : and @ - and no metacharacter at all: a value carrying a . or a | would pin a pattern, and a pattern admits clients nobody named. Empty is allowed here and refused at render time whenever a principal exists, so that the refusal can say what an unpinned audience costs."
    },
    "resources": {
      "type": "object",
      "description": "Kubernetes resource requirements; passed through untouched. The chart refuses requests that differ from limits and a fractional CPU.",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subchart": {
      "type": "object",
      "description": "An upstream chart's own values. Left open on purpose: the vendor owns this surface."
    },
    "storeAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "backupJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "$ref": "#/definitions/subchart"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "ha": {
      "type": "boolean",
      "description": "Zone-redundant mode. Refused with fewer than two zones."
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "interval": {
      "$ref": "#/definitions/duration",
      "description": "The scrape interval, the metrics store's deduplication window and both vmalerts' evaluation interval. One value."
    },
    "vmauth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "v1.152.0 or later: earlier builds matched claim values unanchored (GHSA-f99m-22fh-qw96)."
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "extraArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "deniedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loadBalancingPolicy": {
          "type": "string",
          "enum": [
            "first_available",
            "least_loaded"
          ]
        },
        "retryStatusCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimName"
      ],
      "properties": {
        "issuerUrl": {
          "type": "string"
        },
        "audience": {
          "$ref": "#/definitions/audience",
          "description": "The client id this proxy's tokens are minted under, pinned into every reader's matchClaims as `aud`. REQUIRED whenever principals are set: vmauth validates a token's expiry and, under OIDC discovery, its issuer, and nothing else - it has no audience option and never inspects aud itself - so without this pin any unexpired token from that issuer is admitted whatever client it was minted for."
        },
        "claimName": {
          "type": "string",
          "minLength": 1
        },
        "clusterLabel": {
          "$ref": "#/definitions/labelName",
          "description": "The metrics label carrying the cluster. Default k8s_cluster_name, which is what charts/observability-emitters stamps."
        },
        "namespaceLabel": {
          "$ref": "#/definitions/labelName",
          "description": "The metrics label carrying the namespace. Default k8s_namespace_name."
        },
        "logsClusterField": {
          "$ref": "#/definitions/logFieldName",
          "description": "The log STREAM FIELD carrying the cluster. Default k8s.cluster.name, the conventional name both log writers stamp."
        },
        "logsNamespaceField": {
          "$ref": "#/definitions/logFieldName",
          "description": "The log STREAM FIELD carrying the namespace. Default kubernetes.pod_namespace: the container-log agent's native spelling, because it cannot rename a field and the gateway is configured to write the same one."
        },
        "allowUnfilteredTraceReads": {
          "type": "boolean",
          "description": "Admit the trace read route although nothing can scope it. vmauth applies a principal's filters by substituting them into the route, and VictoriaTraces' Jaeger and Tempo select APIs accept no query argument to substitute them into - so every principal who can read traces reads EVERY tenant's spans. Off by default, and required whenever a trace store is enabled alongside principals."
        },
        "principals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "grants"
            ],
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1
              },
              "grants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cluster"
                  ],
                  "properties": {
                    "cluster": {
                      "$ref": "#/definitions/name"
                    },
                    "namespaces": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/definitions/name"
                      },
                      "description": "An EMPTY list is refused rather than read as everything: a project that expands to no namespaces is the likeliest way a grant widens by accident."
                    },
                    "allNamespaces": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tokenSecret",
              "destinations"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/name"
              },
              "tokenSecret": {
                "$ref": "#/definitions/secretRef"
              },
              "destinations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "metrics",
                    "logs",
                    "traces"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "storeCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "usernameKey",
        "passwordKey"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/definitions/storeAddress"
        },
        "logs": {
          "$ref": "#/definitions/storeAddress"
        },
        "traces": {
          "$ref": "#/definitions/storeAddress"
        }
      }
    },
    "vmalert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "externalUrl": {
          "type": "string"
        },
        "externalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "alertmanager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "notifierUrl": {
          "type": "string"
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "repeatInterval": {
              "$ref": "#/definitions/duration"
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "receiver"
              ],
              "properties": {
                "receiver": {
                  "type": "string",
                  "minLength": 1
                },
                "groupBy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "groupWait": {
                  "$ref": "#/definitions/duration"
                },
                "groupInterval": {
                  "$ref": "#/definitions/duration"
                },
                "repeatInterval": {
                  "$ref": "#/definitions/duration"
                }
              }
            },
            "receivers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "inhibitRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "proxyFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Kubernetes NetworkPolicyPeer objects; passed through untouched."
        },
        "writersFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destination": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "fullSchedule": {
              "type": "string",
              "minLength": 1
            },
            "claimName": {
              "type": "string"
            },
            "image": {
              "$ref": "#/definitions/image"
            }
          }
        },
        "logs": {
          "$ref": "#/definitions/backupJob"
        },
        "traces": {
          "$ref": "#/definitions/backupJob"
        }
      }
    },
    "victoria-metrics-k8s-stack": {
      "$ref": "#/definitions/subchart"
    },
    "victoria-logs-single": {
      "$ref": "#/definitions/subchart"
    },
    "victoria-traces-single": {
      "$ref": "#/definitions/subchart"
    },
    "grafana": {
      "$ref": "#/definitions/subchart"
    }
  }
}
