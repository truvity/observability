{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "observability-mcp",
  "description": "Read-only MCP connectors over observability stores and Grafana. Strict: an unknown key fails the render rather than being silently ignored. Whether a value an enabled connector needs is EMPTY is a render-time refusal in templates/_validate.tpl, with a message that says what the empty value would cost.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stores", "grafana", "networkPolicy"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "peers": {
      "type": "array",
      "description": "NetworkPolicy peers, exactly as the NetworkPolicy API shapes one entry of a `from`/`to` list.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "toolList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "prefix": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,32}$" },
        "entrypointPath": { "type": "string", "pattern": "^(/[A-Za-z0-9._~-]+)*$" },
        "tools": { "$ref": "#/definitions/toolList" },
        "disabledTools": { "$ref": "#/definitions/toolList" }
      }
    },
    "outbound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenEndpoint": { "type": "string", "pattern": "^(https://[^\\s#]+)?$" },
        "clientId": { "type": "string" },
        "audience": { "type": "string" }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "description": "A PEM CA bundle for a private CA, from exactly one of a ConfigMap or a Secret key.",
      "properties": {
        "configMap": { "$ref": "#/definitions/keyRef" },
        "secret": { "$ref": "#/definitions/keyRef" }
      }
    },
    "keyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "podPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "resourceURL": {
      "type": "string",
      "pattern": "^(https://[^\\s#]+)?$",
      "description": "https, no fragment. Empty is refused at render time."
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "resourceURL": { "$ref": "#/definitions/resourceURL" },
        "scope": { "type": "string", "pattern": "^[^\\s\"\\\\]+$" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "clusters": { "type": "array", "items": { "type": "string" } },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": { "type": "boolean" },
            "logs": { "type": "boolean" },
            "traces": { "type": "boolean" }
          }
        },
        "metricsMetadata": { "type": "boolean" },
        "instructions": { "type": "string" },
        "vmauth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "description": "A base URL: scheme and host, no path. Empty or a path is refused at render time." },
            "metricsPath": { "type": "string", "pattern": "^(/[A-Za-z0-9._~-]+)*$" },
            "caBundle": { "$ref": "#/definitions/caBundle" },
            "podPort": { "$ref": "#/definitions/podPort" }
          }
        },
        "outbound": { "$ref": "#/definitions/outbound" }
      }
    }
  },
  "properties": {
    "issuerURL": { "type": "string", "pattern": "^(https://[^\\s#]+)?$" },
    "clusterLabel": { "type": "string", "minLength": 1 },
    "logsClusterField": { "type": "string", "minLength": 1 },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "aggregator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "callTimeout": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$" },
        "resources": { "type": "object" }
      }
    },
    "serviceAccountToken": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "expirationSeconds": { "type": "integer", "minimum": 600 }
      }
    },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "victoriametrics": { "$ref": "#/definitions/upstream" },
        "victorialogs": { "$ref": "#/definitions/upstream" },
        "victoriatraces": { "$ref": "#/definitions/upstream" },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "runAsUser": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" },
            "enabledTools": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": { "$ref": "#/definitions/store" }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "resourceURL": { "$ref": "#/definitions/resourceURL" },
        "scope": { "type": "string", "pattern": "^[^\\s\"\\\\]+$" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^(https?://[^\\s/]+)?$", "description": "A base URL: scheme and host, no path." },
        "caBundle": { "$ref": "#/definitions/caBundle" },
        "podPort": { "$ref": "#/definitions/podPort" },
        "outbound": { "$ref": "#/definitions/outbound" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "$ref": "#/definitions/peers" },
        "metricsFrom": { "$ref": "#/definitions/peers" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": { "$ref": "#/definitions/peers" },
            "vmauth": { "$ref": "#/definitions/peers" },
            "grafana": { "$ref": "#/definitions/peers" }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
