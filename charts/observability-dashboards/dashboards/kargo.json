    {
      "id": 5,
      "type": "stat",
      "title": "Promotions Running",
      "description": "Promotions in the Running phase now. A number that stays above zero for long is a stuck Promotion: open it in Kargo and read its steps.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(kargo_promotion_phase{k8s_cluster_name=~\"$cluster\",namespace=~\"$namespace\",phase=\"Running\"} == 1) or (0 * count(kargo_promotion_phase{k8s_cluster_name=~\"$cluster\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
