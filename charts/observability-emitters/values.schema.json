{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "observability-emitters",
  "description": "Per-cluster collection. Strict: an unknown key fails the render rather than being silently ignored, because in a collection chart a key that does not apply is a label that is never stamped, a destination that is never written to, or a buffer that was never on a volume \u2014 and every one of those renders, syncs and reports healthy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interval",
    "tenancy",
    "writeCredentials",
    "remote",
    "metrics",
    "logs",
    "kubeStateMetrics",
    "nodeExporter",
    "otlp",
    "selfMonitor"
  ],
  "definitions": {
    "plainName": {
      "type": "string",
      "description": "A lowercase plain name. Interpolated into a filter expression on the read side, so a name carrying `|` or `.*` would widen a grant rather than look odd.",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|Ki|Mi|Gi|Ti|Pi)?$"
    },
    "resources": {
      "type": "object",
      "description": "Requests equal limits, integer CPU. Kubernetes' own shape, so it is not further constrained here; the render refuses the combinations that matter.",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "namedDestinations": {
      "type": "array",
      "description": "Every entry receives every sample: replication is the writer's job. An empty list is refused at render.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/plainName"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "caSecret": {
            "$ref": "#/definitions/secretRef",
            "description": "OPTIONAL. A Secret holding a PEM CA bundle to trust for THIS destination's TLS, for a `url` whose certificate is not publicly trusted (a private/estate root). The chart takes the NAME of a Secret and never a value; it mounts the named key as a file and points the destination's own TLS config at it — `tlsConfig.ca.secret` on a VMAgent `remoteWrite` entry (the operator mounts it), or a volume this chart mounts itself for the OTLP gateway's exporters, whichever list this entry is in. Unset: the destination's certificate must already chain to a publicly-trusted root, or to one already trusted by the pod's own OS trust store."
          },
          "tokenSecret": {
            "$ref": "#/definitions/secretRef",
            "description": "OPTIONAL. This destination's OWN bearer (a Secret name and key), in place of the cluster's write credential. A store authenticates one user per token, so the second half of an HA pair is written with a credential of its own. The chart takes the NAME and never a value. Unset: the cluster's write credential."
          }
        }
      }
    },
    "otlpQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClassName": {
          "type": "string"
        },
        "maxBatches": {
          "type": "integer",
          "minimum": 0,
          "description": "Cap on each OTLP exporter's own on-disk `sending_queue`, in batches (`queue_size`), so one stalled destination cannot take the whole volume from the others. 0 leaves the collector's default."
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClassName": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "interval": {
      "$ref": "#/definitions/duration",
      "description": "The scrape interval, and the number the store's deduplication window has to equal."
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "environment"
      ],
      "description": "The two values constant for the cluster. The NAMES the emitters stamp are not values: they are OpenTelemetry's, and pkg/tenancy filters on the same spellings.",
      "properties": {
        "cluster": {
          "type": "string",
          "description": "This cluster's name: half of the scoping key, matched exactly by every grant. Required; blank is refused at render, where the refusal can say what a blank key costs."
        },
        "environment": {
          "type": "string",
          "description": "The environment tier, the value of deployment.environment.name (production, staging, development, test, or any plain name). Descriptive, never a key. Required; blank is refused at render."
        },
        "owners": {
          "type": "object",
          "description": "OPT-IN. Owner name to the namespace patterns (`*` globs) it owns, stamped as `owner` on every series, OTLP log record and span so Alertmanager can route by company. Empty renders nothing. Names and patterns are shape-checked at render.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "defaultOwner": {
          "type": "string",
          "description": "The owner of everything no pattern matches. Empty: unmatched series carry no `owner`. Refused unless `owners` is non-empty."
        }
      }
    },
    "writeCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "key"
      ],
      "properties": {
        "secretName": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "description": "The single-destination sugar. Off (empty `url`) by default; see this chart's own values.yaml comment on `remote` for the full shape and what it expands into.",
      "required": [
        "url",
        "tokenSecret",
        "caSecret",
        "signals",
        "name"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional; either empty or a full {name, key} pair.",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["metrics", "logs", "traces"]
          }
        },
        "name": {
          "$ref": "#/definitions/plainName"
        },
        "replicas": {
          "type": "array",
          "description": "The other halves of an HA store pair: every signal `remote` covers is written to `url` AND to each entry, each with its own queue and its own credential.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "tokenSecret"],
            "properties": {
              "name": { "$ref": "#/definitions/plainName" },
              "url": { "type": "string", "minLength": 1 },
              "tokenSecret": { "$ref": "#/definitions/secretRef" },
              "caSecret": { "$ref": "#/definitions/secretRef", "description": "Defaults to `remote.caSecret`." }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "destinations",
        "image",
        "replicaCount",
        "resources",
        "queue",
        "scrape",
        "spec"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destinations": {
          "$ref": "#/definitions/namedDestinations"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "queue": {
          "$ref": "#/definitions/queue"
        },
        "scrape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kubelet",
            "cadvisor"
          ],
          "properties": {
            "kubelet": {
              "type": "boolean"
            },
            "cadvisor": {
              "type": "boolean"
            },
            "cadvisorAsKubeletJob": {
              "type": "boolean"
            },
            "probes": {
              "type": "array",
              "description": "HTTP probes: a VMProbe per entry, answered by the blackbox exporter (`blackboxExporter`). See values.yaml `metrics.scrape.probes`.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://[^/?#@\\s]+(/[^?#\\s]*)?$",
                    "description": "scheme://host[:port][/path]: no user info, no query, no fragment."
                  },
                  "module": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A key of `blackboxExporter.modules`; default `http_2xx`."
                  },
                  "interval": {
                    "type": "string",
                    "pattern": "^[0-9]+(ms|s|m|h)$"
                  }
                }
              }
            },
            "nodeLabels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kubeletDrop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "description": "A default DROP, on the kubelet scrape only, for series nothing here reads — see this chart's own values.yaml comment on `metrics.scrape.kubeletDrop`.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "metricNames": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extraMetricNames": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "cadvisorDrop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "description": "A default DROP, on the cadvisor scrape only, for never-queried high-cardinality series — see this chart's own values.yaml comment on `metrics.scrape.cadvisorDrop` for the measurement and the mechanism.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "metricNames": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extraMetricNames": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "keepBucketMetrics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extraKeepBucketMetrics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "spec": {
          "type": "object",
          "description": "Merged over the VMAgent spec this chart renders. The vendor's surface, so it is not constrained here \u2014 but the settings that turn off the scoping-key stamp, replication or buffering are refused at render, against the merged result."
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "description": "The log agent. Its destinations, stream fields and buffer are the upstream chart's own keys under `victoria-logs-collector`, read back and refused by this chart, rather than a second set that would have to be kept in step with them.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "kubeStateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "description": "Off by default. Its RBAC, its collector allow-list and the metric-relabel that corrects its namespace stamp are `kube-state-metrics`'s own keys below, read back and refused by this chart, rather than a second set that would have to be kept in step with them.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "customResources": {
          "type": "object",
          "additionalProperties": false,
          "description": "Named presets, each turning kube-state-metrics' own `customResourceState` onto one CRD family this chart already knows how to shape.",
          "properties": {
            "kargo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "description": "Off by default. `kargo_stage_condition` and `kargo_promotion_phase`, the shape `charts/platform-alerts`' `groups.kargo` reads — see this chart's own values.yaml comment on `kubeStateMetrics.customResources.kargo` for the full mechanism.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "nodeClaims": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "description": "Off by default. `nodeclaim_status_condition`, the shape `charts/platform-alerts`' `groups.nodeClaims` reads: Karpenter NodeClaim conditions (`karpenter.sh/v1`). Grants only get/list/watch on `nodeclaims.karpenter.sh`.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "nodeExporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "description": "Off by default. The collector set, the scheduling defaults and the scrape object are `prometheus-node-exporter`'s own keys below, read back and refused by this chart, rather than a second set that would have to be kept in step with them.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "blackboxExporter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "resources": { "type": "object" },
        "modules": {
          "type": "object",
          "description": "Blackbox exporter modules by name, in the exporter's own configuration shape.",
          "additionalProperties": {
            "type": "object",
            "required": ["prober"],
            "properties": { "prober": { "type": "string", "enum": ["http", "tcp", "icmp", "dns", "grpc"] } }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "otlp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "replicaCount",
        "resources",
        "queue",
        "destinations",
        "streamFields",
        "events",
        "service",
        "podMonitor",
        "podSecurityContext"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "queue": {
          "$ref": "#/definitions/otlpQueue"
        },
        "destinations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metrics",
            "logs",
            "traces"
          ],
          "properties": {
            "metrics": {
              "$ref": "#/definitions/namedDestinations"
            },
            "logs": {
              "$ref": "#/definitions/namedDestinations"
            },
            "traces": {
              "$ref": "#/definitions/namedDestinations"
            }
          }
        },
        "streamFields": {
          "type": "array",
          "description": "Resource attributes that become log stream fields. Refused empty, must carry both scoping keys, and every entry must be one the chart knows to be constant for the lifetime of a pod.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grpcPort",
            "httpPort"
          ],
          "properties": {
            "grpcPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "httpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "httpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maxRequestBodyBytes": {
              "type": "integer",
              "minimum": 1
            },
            "namespace": {
              "$ref": "#/definitions/plainName"
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "deleteAttributes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ingressFrom": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraLabels": {
              "type": "object"
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        }
      }
    },
    "selfMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object"
        }
      }
    },
    "victoria-logs-collector": {
      "type": "object",
      "description": "Passed through to the vendored upstream chart, and read back by this chart's refusals. Upstream's surface, not this chart's, so it is not constrained here \u2014 a key this chart does not know about is still upstream's to interpret."
    },
    "kube-state-metrics": {
      "type": "object",
      "description": "Passed through to the vendored upstream chart, and read back by this chart's refusals \u2014 the RBAC scope, the collector allow-list and the metric-relabel that corrects the namespace stamp among them. Upstream's surface, not this chart's, so it is not constrained here."
    },
    "prometheus-node-exporter": {
      "type": "object",
      "description": "Passed through to the vendored upstream chart, and read back by this chart's refusals \u2014 host network and PID, the scrape object and the relabelings that give it `job`, `instance` and `node`. Upstream's surface, not this chart's, so it is not constrained here."
    },
    "global": {
      "type": "object",
      "description": "Helm's shared subchart values. Upstream's surface."
    }
  }
}
