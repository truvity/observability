# expect: has no path
# PathPrefix / would swallow the whole host.
issuerURL: https://issuer.example.com
proxy:
  image:
    tag: v0.0.1
stores:
  - name: primary
    resourceURL: https://mcp.example.com
    vmauth: {url: "http://vmauth.monitoring.svc:8427"}
    outbound:
      tokenEndpoint: https://issuer.example.com/token
      clientId: observability-mcp-primary
      audience: primary-store
networkPolicy:
  ingressFrom:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: gateway}}
  egress:
    issuer: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: issuer}}}]
    vmauth: [{podSelector: {matchLabels: {app.kubernetes.io/name: vmauth}}}]

httpRoute:
  enabled: true
  parentRefs: [{name: mcp}]
