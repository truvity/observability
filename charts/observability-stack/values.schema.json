{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "observability-stack",
  "description": "One install of a self-hosted observability stack. Strict where this chart defines the structure: an unknown key fails the render rather than being silently ignored, because a typo in a retention, a filter or a secret name is an install that comes up and is wrong. The upstream charts' own sections stay open \u2014 their surface is theirs, and closing it would refuse every legitimate key the vendor adds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interval",
    "storeCredentials",
    "vmauth",
    "tenancy"
  ],
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$",
      "description": "A duration with a unit, e.g. 30s, 5m, 1h."
    },
    "retention": {
      "type": "string",
      "pattern": "^[0-9]+(h|d|w|M|y)$",
      "description": "A retention period WITH A UNIT. A bare number is read as months by every store in this family, so the unit is required here rather than left to a default nobody expects. The month unit is a capital M."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "A plain name. This is a security boundary rather than a style rule: cluster and namespace names are interpolated into a filter expression, so one carrying | or .* would widen the grant it appears in."
    },
    "labelName": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "description": "A Prometheus label name: the key a metrics filter selects on, so it has to be one a series can carry - no dots, no dashes, no slashes."
    },
    "logFieldName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_./-]*$",
      "description": "A LOG FIELD NAME, which is a different question from a plain name and has a different answer. A log agent names its own fields, and a real one carries dots: kubernetes.pod_namespace, k8s.cluster.name. The shape admits those and refuses everything that is stream-filter syntax - a quote, a brace, a comma, an equals sign, a pipe, a colon, whitespace - because the name is interpolated into the filter and one of those would widen the grant rather than look odd."
    },
    "audience": {
      "type": "string",
      "pattern": "^\\S*$",
      "description": "An OAuth client id: the audience this proxy's tokens are minted for. It is whatever the issuer assigned - a UUID, a name, an <id>@<project> - and is escaped and anchored where it is rendered, so a dot or a pipe in it pins itself rather than a pattern. Only a value no issuer mints is refused here: one carrying whitespace or a newline, which is usually a value that arrived from the wrong place. Empty is allowed by the schema and refused at render time whenever a principal exists, so that the refusal can say what an unpinned audience costs."
    },
    "resources": {
      "type": "object",
      "description": "Kubernetes resource requirements; passed through untouched. The chart refuses requests that differ from limits and a fractional CPU.",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "severityTarget": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where a severity tier lands when no route says otherwise. `receiver` names a configured receiver kind - `slack`, or the name of an entry in `notifications.webhook` - and `channel` is where the Slack template's channel and receiver-naming come from; a route may override it per project but never the receiver kind.",
      "required": [
        "receiver",
        "channel"
      ],
      "properties": {
        "receiver": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subchart": {
      "type": "object",
      "description": "An upstream chart's own values. Left open on purpose: the vendor owns this surface."
    },
    "selfAlertSeverity": {
      "type": "string",
      "enum": ["critical", "warning"],
      "description": "This chart's own rules carry only `critical` and `warning`, the same convention docs/notifications.md documents for the routing tree: `critical` means look now, `warning` means look today. There is no `info` tier here: an alert that pages nobody belongs in Grafana, not in a VMRule this chart renders."
    },
    "optionalMetricPair": {
      "type": "object",
      "additionalProperties": false,
      "description": "A gauge and its limit, from the SAME component. Neither is defaulted; setting one without the other is refused, and leaving both empty renders no rule for it, which is the honest outcome for a name this chart could not confirm.",
      "properties": {
        "freeSpaceMetric": { "type": "string" },
        "freeSpaceLimitMetric": { "type": "string" }
      }
    },
    "storeAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "backupJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "$ref": "#/definitions/subchart"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "ha": {
      "type": "boolean",
      "description": "Zone-redundant mode. Refused with fewer than two zones."
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "interval": {
      "$ref": "#/definitions/duration",
      "description": "The scrape interval, the metrics store's deduplication window and both vmalerts' evaluation interval. One value."
    },
    "vmauth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "v1.152.0 or later: earlier builds matched claim values unanchored (GHSA-f99m-22fh-qw96)."
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "extraArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "deniedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loadBalancingPolicy": {
          "type": "string",
          "enum": [
            "first_available",
            "least_loaded"
          ]
        },
        "retryStatusCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimName"
      ],
      "properties": {
        "issuerUrl": {
          "type": "string"
        },
        "audience": {
          "$ref": "#/definitions/audience",
          "description": "The client id this proxy's tokens are minted under, pinned into every reader's matchClaims as `aud`. REQUIRED whenever principals are set: vmauth validates a token's expiry and, under OIDC discovery, its issuer, and nothing else - it has no audience option and never inspects aud itself - so without this pin any unexpired token from that issuer is admitted whatever client it was minted for. Escaped and anchored where it is rendered, so whatever the issuer assigned pins itself and nothing else."
        },
        "claimName": {
          "type": "string",
          "minLength": 1
        },
        "clusterLabel": {
          "$ref": "#/definitions/labelName",
          "description": "The metrics label carrying the cluster. Default k8s_cluster_name, which is what charts/observability-emitters stamps."
        },
        "namespaceLabel": {
          "$ref": "#/definitions/labelName",
          "description": "The metrics label carrying the namespace. Default k8s_namespace_name."
        },
        "logsClusterField": {
          "$ref": "#/definitions/logFieldName",
          "description": "The log STREAM FIELD carrying the cluster. Default k8s.cluster.name, the conventional name both log writers stamp."
        },
        "logsNamespaceField": {
          "$ref": "#/definitions/logFieldName",
          "description": "The log STREAM FIELD carrying the namespace. Default kubernetes.pod_namespace: the container-log agent's native spelling, because it cannot rename a field and the gateway is configured to write the same one."
        },
        "allowUnfilteredTraceReads": {
          "type": "boolean",
          "description": "Admit the trace read route although nothing can scope it. vmauth applies a principal's filters by substituting them into the route, and VictoriaTraces' Jaeger and Tempo select APIs accept no query argument to substitute them into - so every principal who can read traces reads EVERY tenant's spans. Off by default, and required whenever a trace store is enabled alongside principals."
        },
        "allowUnfilteredMetricMetadata": {
          "type": "boolean",
          "description": "Admit /api/v1/metadata on the metrics read route. It returns every metric name, type and help in the store and no filter reaches it, so every principal sees the same list whatever their grant. Off by default; the visible cost of off is a 401 in Grafana's datasource log where metric descriptions would be."
        },
        "principals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "grants"
            ],
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1
              },
              "grants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cluster"
                  ],
                  "properties": {
                    "cluster": {
                      "$ref": "#/definitions/name"
                    },
                    "namespaces": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/definitions/name"
                      },
                      "description": "An EMPTY list is refused rather than read as everything: a project that expands to no namespaces is the likeliest way a grant widens by accident."
                    },
                    "allNamespaces": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tokenSecret",
              "destinations"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/name"
              },
              "tokenSecret": {
                "$ref": "#/definitions/secretRef"
              },
              "destinations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "metrics",
                    "logs",
                    "traces"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "storeCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "usernameKey",
        "passwordKey"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/definitions/storeAddress"
        },
        "logs": {
          "$ref": "#/definitions/storeAddress"
        },
        "traces": {
          "$ref": "#/definitions/storeAddress"
        }
      }
    },
    "vmalert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "evalDelay": {
              "$ref": "#/definitions/duration",
              "description": "`-rule.evalDelay` for the logs alerter only. The 30s default exists to match `-search.latencyOffset`, a VictoriaMetrics flag that compensates for query-time data delay on the METRICS store; VictoriaLogs has no such offset, so inheriting it delays every log-based alert by 30s for a latency that store does not have."
            }
          }
        },
        "externalUrl": {
          "type": "string"
        },
        "externalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "alertmanager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "notifierUrl": {
          "type": "string"
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "repeatInterval": {
              "$ref": "#/definitions/duration"
            },
            "timeout": {
              "$ref": "#/definitions/duration",
              "description": "The far end's OWN timeout for a missing heartbeat - not read from it, stated here so the chart can refuse a `repeatInterval` that would not arrive comfortably inside it. Optional: leave it unset and the chart trusts the operator to have set `repeatInterval` sanely, the way it always has."
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "description": "The one router: renders the Alertmanager configuration `alertmanager.enabled` needs so it never falls back to the `blackhole` shape. See docs/notifications.md.",
      "properties": {
        "externalUrl": {
          "type": "string",
          "description": "The base of the Grafana link this chart puts in every Slack message. Required the moment a receiver kind is configured; without it every link in a notification points at nothing a person can open."
        },
        "runbookBaseUrl": {
          "type": "string",
          "description": "Prefixed to a firing rule's `runbook` annotation to make the runbook link. Left empty, the chart renders no runbook line rather than a link to a base URL with nothing after it."
        },
        "groupWait": {
          "$ref": "#/definitions/duration"
        },
        "groupInterval": {
          "$ref": "#/definitions/duration"
        },
        "repeatInterval": {
          "$ref": "#/definitions/duration"
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "webhookSecret"
          ],
          "properties": {
            "webhookSecret": {
              "$ref": "#/definitions/secretRef"
            }
          }
        },
        "webhook": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "urlSecret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "urlSecret": {
                "$ref": "#/definitions/secretRef"
              }
            }
          }
        },
        "severities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "critical": {
              "$ref": "#/definitions/severityTarget"
            },
            "warning": {
              "$ref": "#/definitions/severityTarget"
            }
          }
        },
        "routes": {
          "type": "array",
          "description": "In order. The first entry whose `match` is satisfied wins, per severity; an entry naming only `critical` sends its warnings to `severities.warning`.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match"
            ],
            "properties": {
              "match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Alertmanager label matchers, exact-match only. The vocabulary the collectors stamp on every alert is `k8s_cluster_name` and `k8s_namespace_name`; anything else matches nothing a rule actually carries."
              },
              "critical": {
                "type": "string",
                "minLength": 1
              },
              "warning": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "also": {
          "type": "array",
          "description": "Which alerts ALSO reach a webhook receiver, beside their normal route - the status-page bridge. Matchers, not channels: an entry is delivered in addition to, never instead of, the primary Slack route.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receiver",
              "match"
            ],
            "properties": {
              "receiver": {
                "type": "string",
                "minLength": 1,
                "description": "The name of an entry in `notifications.webhook`."
              },
              "match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "proxyFrom": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Kubernetes NetworkPolicyPeer objects; passed through untouched."
        },
        "writersFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destination": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "fullSchedule": {
              "type": "string",
              "minLength": 1
            },
            "claimName": {
              "type": "string"
            },
            "image": {
              "$ref": "#/definitions/image"
            }
          }
        },
        "logs": {
          "$ref": "#/definitions/backupJob"
        },
        "traces": {
          "$ref": "#/definitions/backupJob"
        }
      }
    },
    "selfAlerts": {
      "type": "object",
      "additionalProperties": false,
      "description": "The nineteen store self-alerts. See docs/notifications.md, \"Store self-alerts\", and values.yaml's own comments for which of the nineteen metric names this chart could confirm and which it could not.",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": { "type": "string" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/selfAlertSeverity" }
          }
        },
        "cardinality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hourlyCurrentSeriesMetric": { "type": "string" },
            "hourlyMaxSeriesMetric": { "type": "string" },
            "dailyCurrentSeriesMetric": { "type": "string" },
            "dailyMaxSeriesMetric": { "type": "string" },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "Above 0 and below 1: at or above 1 the alert arrives at the moment the limit has already bitten."
            },
            "severity": { "$ref": "#/definitions/selfAlertSeverity" }
          }
        },
        "logStore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": { "type": "string" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/selfAlertSeverity" }
          }
        },
        "traceStore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": { "type": "string" },
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" },
            "severity": { "$ref": "#/definitions/selfAlertSeverity" }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "queueSizeMetric": { "type": "string" },
            "queueCapacityMetric": { "type": "string" },
            "queueRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "queueFor": { "$ref": "#/definitions/duration" },
            "queueSeverity": { "$ref": "#/definitions/selfAlertSeverity" },
            "exportFailedMetricPrefix": { "type": "string" },
            "exportFailWindow": { "$ref": "#/definitions/duration" },
            "exportFailFor": { "$ref": "#/definitions/duration" },
            "exportFailSeverity": { "$ref": "#/definitions/selfAlertSeverity" },
            "enqueueFailedMetricPrefix": { "type": "string" },
            "enqueueFailWindow": { "$ref": "#/definitions/duration" },
            "enqueueFailFor": { "$ref": "#/definitions/duration" },
            "enqueueFailSeverity": { "$ref": "#/definitions/selfAlertSeverity" }
          }
        },
        "diskGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headroomFactor": {
              "type": "number",
              "exclusiveMinimum": 1,
              "description": "Above 1, or the alert arrives at the moment the store already stopped accepting writes. Mirrors platform-alerts' storeLimits.headroomFactor."
            },
            "severity": { "$ref": "#/definitions/selfAlertSeverity" },
            "metrics": { "$ref": "#/definitions/optionalMetricPair" },
            "logs": { "$ref": "#/definitions/optionalMetricPair" },
            "traces": { "$ref": "#/definitions/optionalMetricPair" }
          }
        },
        "snapshotAge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severity": { "$ref": "#/definitions/selfAlertSeverity" },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "maxAge": { "$ref": "#/definitions/duration" } }
            },
            "logs": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "maxAge": { "$ref": "#/definitions/duration" } }
            },
            "traces": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "maxAge": { "$ref": "#/definitions/duration" } }
            }
          }
        },
        "logStreamChurn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "streamsCreatedMetric": { "type": "string" },
            "perSecond": {
              "type": "number",
              "minimum": 0,
              "description": "Streams created per second, averaged over an hour. A healthy install creates roughly a stream per pod per day; the default is two orders of magnitude above that."
            },
