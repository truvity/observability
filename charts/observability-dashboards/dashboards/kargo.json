    {
      "id": 7,
      "type": "stat",
      "title": "Promotions failed",
      "description": "Promotions that finished in the Failed phase and are still in the cluster. Failed is terminal: read the failed step and fix the cause before promoting again.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(kargo_promotion_phase{k8s_cluster_name=~\"$cluster\",namespace=~\"$namespace\",phase=\"Failed\"} == 1) or (0 * count(kargo_promotion_phase{k8s_cluster_name=~\"$cluster\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "n/a",
