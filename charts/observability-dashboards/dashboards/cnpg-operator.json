    {
      "id": 8,
      "type": "timeseries",
      "title": "Reconcile duration p95, by controller",
      "description": "The 95th-percentile time a reconcile takes, per control loop. A loop that slows down delays every change to a Postgres cluster behind it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
