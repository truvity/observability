{
  "title": "Example ($cluster)",
  "templating": {
    "list": [
      {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "", "value": ""}},
      {
        "name": "cluster",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "definition": "label_values(up, k8s_cluster_name)",
        "query": {"query": "label_values(up, k8s_cluster_name)"},
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "panels": [
    {
      "title": "Pods by phase",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"expr": "sum(kube_pod_status_phase{k8s_cluster_name=~\"$cluster\",k8s_namespace_name=\"example-namespace\"}) by (phase)"}
