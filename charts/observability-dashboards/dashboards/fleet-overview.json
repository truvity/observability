    {
      "id": 20,
      "type": "timeseries",
      "title": "Rows ingested per second, by store",
      "description": "The store write path: rows per second accepted by the metrics (vm_), logs (vl_) and traces (vt_) components of this cluster. A flat zero on a store that had traffic means the write path is dead; the WritePathDead alert watches the same counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
