    {
      "id": 6,
      "type": "stat",
      "title": "Promotions errored",
      "description": "Errored Promotions whose Stage has not recovered (the condition the KargoPromotionErrored alert uses). Re-promote once the cause is fixed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((kargo_promotion_phase{k8s_cluster_name=~\"$cluster\",namespace=~\"$namespace\",phase=\"Errored\"} == 1) and on (k8s_cluster_name, namespace, stage) (kargo_stage_condition{k8s_cluster_name=~\"$cluster\",namespace=~\"$namespace\",type=\"Ready\",reason=\"LastPromotionErrored\"} == 0)) or (0 * count(kargo_promotion_phase{k8s_cluster_name=~\"$cluster\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "n/a",
          "decimals": 0,
          "mappings": [],
